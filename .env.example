# Copiez ce fichier en .env.local et remplissez les valeurs nécessaires.
# Voir lib/env.ts pour la liste faisant foi (obligatoire vs optionnel).

# ─── Agent IA ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SESSION_SECRET=
DASHBOARD_PASSWORD=

# ─── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─── Widget public ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=

# ─── Visites 3D (Velinova 3D) ────────────────────────────────────────────
# Voir worker/README.md pour le déploiement du worker de reconstruction.
THREED_PROVIDER=modal
THREED_WORKER_URL=
THREED_WEBHOOK_SECRET=
# URL publique de cette application, utilisée pour construire l'URL de
# webhook envoyée au worker, ET l'URL du pixel de suivi d'ouverture des
# emails d'outreach (voir lib/outreach/email.ts). Optionnel en production
# (déduite de la requête) ; nécessaire en dev local derrière un tunnel (ngrok...).
NEXT_PUBLIC_APP_URL=
